# Copy this file to .env.mail.local and keep the local file out of Git.
# In Brevo, use the SMTP login and SMTP key shown under SMTP & API.
AUTH_MAIL_ENABLED=true
AUTH_SMTP_HOST=smtp-relay.brevo.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=replace-with-brevo-smtp-login
AUTH_SMTP_PASSWORD=replace-with-brevo-smtp-key
AUTH_MAIL_FROM_NAME=Sahha
AUTH_MAIL_FROM_EMAIL=replace-with-verified-brevo-sender@example.com
AUTH_FRONTEND_BASE_URL=http://localhost:5173
AUTH_EMAIL_VERIFICATION_PATH=/verify-email
AUTH_PASSWORD_RESET_PATH=/reset-password
