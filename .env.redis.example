# Copy this file to .env.redis.local only when overriding the local defaults.
# The loopback-only native Memurai setup is described in docs/LOCAL_REDIS.md.
AUTH_SESSION_CACHE_ENABLED=true
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_DATABASE=0
AUTH_REDIS_USERNAME=
AUTH_REDIS_PASSWORD=
AUTH_REDIS_CONNECT_TIMEOUT=500ms
AUTH_REDIS_COMMAND_TIMEOUT=1s
AUTH_SESSION_CACHE_MAXIMUM_ACTIVE_TTL=PT30S
