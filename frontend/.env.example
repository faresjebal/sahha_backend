# Active internship routes use real Gateway adapters. Mock adapters are opt-in
# reference/development tools, not a completed backend-integrated feature.
VITE_USE_MOCKS=false
VITE_USE_AUTH_MOCKS=false

# The browser always calls API Gateway, never a microservice directly. Match this port to SERVER_PORT.
VITE_API_BASE_URL=http://localhost:8079/api/v1
VITE_APP_NAME=Sahha
VITE_REQUEST_TIMEOUT_MS=12000
